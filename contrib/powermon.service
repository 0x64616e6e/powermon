[Unit]
Description=powermon power recorder
Documentation=file:///home/dann/code/powermon/README.md
After=power-profiles-daemon.service

[Service]
# Starts as root only to open the RAPL perf counters (Debian's perf_event_paranoid=3 admits
# CAP_SYS_ADMIN and nothing less), then switches to the desktop user with no capabilities at all.
# Running as that user also lets `powermon stats` etc. signal it to flush its buffer.
ExecStart=/usr/local/bin/powermon record --user dann
ExecReload=/bin/kill -USR1 $MAINPID
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SETUID CAP_SETGID
NoNewPrivileges=yes
StateDirectory=powermon
StateDirectoryMode=0755
RuntimeDirectory=powermon
RuntimeDirectoryMode=0755
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
Nice=10
Restart=on-failure

[Install]
WantedBy=multi-user.target
